; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Exterminator"
run/main_scene="uid://d1ei21obo3bpr"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameDictionary="*uid://cm3om3wvpshgw"
SignalHub="*uid://bolxvfc4ic8v0"
DialogueManager="*res://Externals/DialogueManager/dialogue_manager.gd"
GameState="*uid://cm2g2belw11ol"

[dialogue_manager]

runtime/balloon_path="res://Assets/2D/UI/Speech/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://Externals/DialogueManager/plugin.cfg")

[importer_defaults]

scene={
"_subresources": {
"materials": {
"materials_ruin_map": {
"use_external/enabled": true,
"use_external/fallback_path": "res://Material/M_Ruins.tres",
"use_external/path": "uid://dxt7cr71feqey"
}
},
"nodes": {
"PATH:ruin_16": {
"generate/physics": true,
"physics/shape_type": 1
}
}
},
"animation/fps": 30,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"array_mesh/deduplicate_surfaces": true,
"gltf/embedded_image_handling": 3,
"gltf/naming_version": 2,
"gltf/texture_map_mode": 1,
"import_script/path": "",
"materials/extract": 0,
"materials/extract_format": 0,
"materials/extract_path": "",
"mesh_library/use_node_names_as_mesh_names": false,
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_script": null,
"nodes/root_type": "",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

